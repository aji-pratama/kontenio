# AI Video Factory
# ================

# API Keys
OPENAI_API_KEY=sk-your-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Default Providers (used when creating new projects)
# Options: openai_whisper, gemini, local_whisper
DEFAULT_TRANSCRIPTION_PROVIDER=openai_whisper

# Options: openai_gpt4, openai_gpt4_mini, gemini_pro, gemini_flash
DEFAULT_LLM_PROVIDER=gemini_flash

# Options: dalle3, imagen, gemini_flash, mock
DEFAULT_IMAGE_PROVIDER=dalle3

# Options: modern, cyberpunk, animation, 3d_render, illustration, motion, cinematic
DEFAULT_STYLE_HINT=modern

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-here
